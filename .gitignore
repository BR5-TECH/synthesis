# Logs. Anchored: an unanchored `logs` also matches a source directory of that
# name at any depth, which hides authored work from a change set (GIP-FR-ZKAB).
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
/dist
/dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Playwright evidence from the engineer skill's UI verification harness.
.playwright-mcp/

# pnpm places its store inside the project whenever its own home is on another
# filesystem, which a container bind mount always makes it.
.pnpm-store

# TypeScript's incremental build state. Machine state rather than authored work,
# and a Review turn that runs the project's typecheck is refused over a tracked
# one (specifications/core/GIP-graduation-implementation.md GIP-FR-KONG).
*.tsbuildinfo

# Python bytecode from the specification check's tests
__pycache__/
*.pyc

# Test coverage reports from Vitest. They hold absolute paths of the machine
# that made them.
/coverage/

# Rust build output and tool files. Anchored for the same reason as `/logs/`:
# an unanchored `debug` or `target` also matches a source directory of that name.
/debug/
/target/
**/*.rs.bk
*.pdb
**/mutants.out*/
rustc-ice-*.txt
