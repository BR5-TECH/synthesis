  "functions": {
    "formatString": {
      "type": "object",
      "description": "Interpolates ${/pointer} values into a text.",
      "returnType": "string",
      "properties": {
        "@call": {
          "const": "formatString"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
