          "type": "string"
        }
      },
      "required": [
        "condition"
      ],
      "additionalProperties": false
    },
    "ActionName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
